# Exemplo de Configuração para Testes E2E
# Copie este arquivo para .env.e2e e preencha com seus valores

# ============================================================================
# OBRIGATÓRIO
# ============================================================================

# Token da API Linode (obtenha em: https://cloud.linode.com/profile/tokens)
LINODE_TOKEN=seu-linode-token-aqui

# Flag para habilitar testes E2E
RUN_E2E_TESTS=true

# ============================================================================
# OPCIONAL
# ============================================================================

# Senha root para as instâncias criadas
# Deve conter letras maiúsculas, minúsculas, números e caracteres especiais
E2E_ROOT_PASSWORD=SuaSenhaSegura123!@#

# CIDR permitido para acesso SSH
# Recomendado: usar seu IP específico para maior segurança
# Para obter seu IP: curl ifconfig.me
E2E_ALLOWED_CIDR=0.0.0.0/0

# Repositório Git para testes do ArgoCD
E2E_GIT_REPO=https://github.com/argoproj/argocd-example-apps

# Região padrão da Linode para deploy
# Opções: us-east, us-west, eu-central, ap-south, etc.
E2E_REGION=us-east

# ============================================================================
# TIMEOUTS (em milissegundos)
# ============================================================================

# Timeout para deploy completo do cluster
E2E_DEPLOY_TIMEOUT=900000    # 15 minutos

# Timeout para destruição do cluster
E2E_DESTROY_TIMEOUT=600000   # 10 minutos

# Timeout para pods ficarem prontos
E2E_POD_TIMEOUT=300000       # 5 minutos

# Timeout para nodes ficarem prontos
E2E_NODE_TIMEOUT=600000      # 10 minutos

# ============================================================================
# CLEANUP
# ============================================================================

# Destruir recursos automaticamente após os testes
# true = sempre destruir, false = manter recursos
E2E_AUTO_DESTROY=true

# Manter recursos em caso de falha (útil para debugging)
# true = manter se falhar, false = destruir mesmo com falha
E2E_KEEP_ON_FAILURE=false

# ============================================================================
# DEBUG
# ============================================================================

# Habilitar logs detalhados do Pulumi
# PULUMI_DEBUG_COMMANDS=true

# Nível de log do Pulumi (1-11)
# PULUMI_LOG_LEVEL=9
